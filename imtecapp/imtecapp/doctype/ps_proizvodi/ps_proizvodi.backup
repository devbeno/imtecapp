# import frappe
from frappe.model.document import Document
import frappe


class PSProizvodi(Document):
    pass


# Function to fetch ERPImtec settings
def get_erpimtec_settings():
    return frappe.get_single("Generalne Postavke")


@frappe.whitelist()
def sync_with_proizvodi():
    try:
        # Start the synchronization
        sync_active_products_to_ps_proizvodi()
        frappe.log_error(
            "Sync from Proizvodi to PS Proizvodi completed successfully.",
            "Sync Success",
        )
        return "Synced"
    except Exception as e:
        frappe.log_error(f"Synchronization failed: {str(e)}", "Sync Error")
        return "Error"


def sync_active_products_to_ps_proizvodi():
    active_products = frappe.get_all(
        "Proizvodi",
        filters={"aktivan": 1},
        fields=[
            "art_sifra",
            "vpc",
            "stanje",
            "art_naziv",
            "grupanaziv",
            "proizvodjac",
            "aktivan",
        ],
    )

    for product in active_products:
        try:
            existing_ps_product = frappe.db.get_value(
                "PS Proizvodi",
                {"reference": product["art_sifra"]},
                [
                    "name",
                    "presta_product_id",
                    "presta_category_id",
                    "presta_manufacturer_id",
                ],
            )

            prestadata = get_erpimtec_settings()

            if existing_ps_product:
                # Update existing PS Proizvodi record
                ps_product = frappe.get_doc("PS Proizvodi", existing_ps_product)
                ps_product.update(
                    {
                        "price": product["vpc"],
                        "quantity": product["stanje"],
                        "category": product["grupanaziv"],
                        "manufacturer": product["proizvodjac"],
                        "active": product["aktivan"],
                    }
                )
                ps_product.save()

                # Update in PrestaShop
                if product["aktivan"] == 1:
                    update_prestashop_product(ps_product, prestadata)
                else:
                    deactivate_prestashop_product(ps_product, prestadata)

                frappe.log_error(
                    f"Product {product['art_sifra']} updated in PS Proizvodi and PrestaShop.",
                    "Sync Success",
                )

            else:
                # Create new PS Proizvodi record
                if product["aktivan"] == 1:
                    new_ps_product = frappe.get_doc(
                        {
                            "doctype": "PS Proizvodi",
                            "reference": product["art_sifra"],
                            "price": product["vpc"],
                            "quantity": product["stanje"],
                            "category": product["grupanaziv"],
                            "manufacturer": product["proizvodjac"],
                            "active": 1,
                        }
                    )
                    new_ps_product.insert()
                    create_prestashop_product(new_ps_product, prestadata)
                    frappe.log_error(
                        f"Product {product['art_sifra']} created in PS Proizvodi and PrestaShop.",
                        "Sync Success",
                    )

        except Exception as e:
            frappe.log_error(
                f"Error syncing product {product['art_sifra']}: {str(e)}", "Sync Error"
            )

    frappe.db.commit()


def create_prestashop_product(product, prestadata):
    # Your implementation for creating a product in PrestaShop
    pass


def update_prestashop_product(product, prestadata):
    # Your implementation for updating a product in PrestaShop
    pass


def deactivate_prestashop_product(product, prestadata):
    # Your implementation for deactivating a product in PrestaShop
